{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "lint:fix": { "dependsOn": ["^lint:fix"], "cache": false },
    "test": { "dependsOn": ["^build"] },
    "clean": { "cache": false },
    "typecheck": { "dependsOn": ["^typecheck"] }
  }
}
