# Copy to env/api.local.env. Empty optional values ("KEY=") mean unset.

# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starter

# Optional (defaults shown)
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=100

# Optional — email (noop if unset; Resend then SMTP)
# RESEND_API_KEY=
# EMAIL_FROM=
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_SECURE=false

# Optional — storage (throws if used while unset; AWS_S3_ENDPOINT for R2/MinIO/…)
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_ENDPOINT=
